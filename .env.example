# Official AI API (server-side only)
AI_OFFICIAL_BASE_URL=
AI_OFFICIAL_API_KEY=
AI_OFFICIAL_MODEL=
AI_OFFICIAL_TEMPERATURE=0.7
AI_OFFICIAL_MAX_TOKENS=2000

# AI proxy hardening
# Keep custom upstream proxying disabled in production unless explicitly required.
AI_ENABLE_CUSTOM_MODE=0
# Optional comma-separated site origins allowed to call /api/ai when reverse-proxy
# headers are rewritten or incomplete. Example:
# AI_PROXY_ALLOWED_ORIGINS=https://app.example.com,https://www.app.example.com
AI_PROXY_ALLOWED_ORIGINS=
# Optional comma-separated additional hosts allowed for custom upstreams in production.
# Use * to allow any public HTTPS upstream host.
AI_ALLOWED_UPSTREAM_HOSTS=
# Only enable private/local upstream access for trusted development or internal testing.
AI_ALLOW_PRIVATE_UPSTREAMS=0
# In-memory per-IP rate limit for /api/ai.
AI_PROXY_RATE_LIMIT_WINDOW_MS=60000
AI_PROXY_RATE_LIMIT_MAX_REQUESTS=12
# Upstream time budgets in milliseconds. Streaming responses usually need a longer window.
AI_PROXY_UPSTREAM_TIMEOUT_MS=30000
AI_PROXY_STREAM_TIMEOUT_MS=300000
# Reject unusually large request payloads early.
AI_PROXY_MAX_REQUEST_BYTES=262144
# Guardrails for the number and size of chat messages proxied upstream.
AI_PROXY_MAX_MESSAGES=48
AI_PROXY_MAX_MESSAGE_CHARS=24000
AI_PROXY_MAX_TOTAL_CHARS=120000
