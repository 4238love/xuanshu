.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  height: 108rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(72, 51, 31, 0.14);
  background: rgba(247, 239, 225, 0.97);
  box-sizing: content-box;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #a8988a;
  transition: color 0.18s ease;
}

.tab--on {
  color: #7c4c19;
}

.tab--hover {
  opacity: 0.72;
}

.tab__text {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  line-height: 1;
}

.tab--on .tab__text {
  font-weight: 600;
}

/* ---------- 图标：纯 CSS 绘制，跟随 currentColor ---------- */

.ico {
  position: relative;
  width: 38rpx;
  height: 34rpx;
  color: inherit;
}

/* 首页：屋顶三角 + 房身 */
.ico--home::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  margin-left: -19rpx;
  border-left: 19rpx solid transparent;
  border-right: 19rpx solid transparent;
  border-bottom: 15rpx solid currentColor;
}

.ico--home::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 6rpx;
  right: 6rpx;
  height: 17rpx;
  border: 3rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 4rpx 4rpx;
}

/* 我的：头像圆 + 肩部半圆 */
.ico--mine::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  margin-left: -9rpx;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.ico--mine::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 3rpx;
  right: 3rpx;
  height: 11rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 16rpx 16rpx 0 0;
}
