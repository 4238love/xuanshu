<import src="../../../../templates/birth-form.wxml" />
<import src="../../../../templates/ai-panel.wxml" />

<view class="page-shell">
  <view style="height: {{statusBarHeight}}px"></view>

  <view class="nav-bar">
    <view class="nav-back" bindtap="onBack">‹</view>
    <text class="nav-title">紫微斗数</text>
  </view>

  <!-- ==================== 表单 ==================== -->
  <block wx:if="{{mode === 'form'}}">
    <view class="hero hero--compact">
      <text class="hero__kicker">ZIWEI · PURPLE STAR</text>
      <text class="hero__title">起盘</text>
      <text class="hero__desc">十二宫、主星辅星、四化与大限一次排定，命身主同盘给出。</text>
    </view>

    <template
      is="birth-form"
      data="{{settings: settings, solarDate: solarDate, timeValue: timeValue, showOccupy: showOccupy, occupyLabel: occupyLabel, error: error}}"
    />

    <paper-card title="五行局取法" hint="影响局数与起运">
      <view class="choice-row">
        <view
          wx:for="{{wuXingJuTypes}}"
          wx:key="value"
          class="choice {{settings.wuXingJuType === item.value ? 'choice--active' : ''}}"
          data-field="wuXingJuType"
          data-value="{{item.value}}"
          bindtap="onSelectOption"
        >{{item.label}}</view>
      </view>
    </paper-card>

    <button class="primary-btn" loading="{{loading}}" bindtap="onSubmit">{{loading ? '正在排盘' : '开始排盘'}}</button>
  </block>

  <!-- ==================== 结果 ==================== -->
  <block wx:else>
    <view class="res-hero">
      <view class="res-hero__tags">
        <text class="tag tag--dark">紫微斗数</text>
        <text class="tag tag--dark">命宫 {{vm.mingGongName}}</text>
      </view>
      <text class="res-hero__kicker">命盘</text>
      <text class="res-hero__name">{{vm.title}}</text>
      <text class="res-hero__sub">{{vm.sub}}</text>

      <view class="metric-grid">
        <view wx:for="{{vm.headMetrics}}" wx:key="label" class="metric">
          <text class="metric__label">{{item.label}}</text>
          <text class="metric__value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <paper-card title="四化" hint="生年四化">
      <view class="hua-grid">
        <view wx:for="{{vm.siHua}}" wx:key="label" class="hua">
          <text class="hua__label">{{item.label}}</text>
          <text class="hua__star">{{item.value}}</text>
        </view>
      </view>
    </paper-card>

    <paper-card title="十二宫" hint="寅起顺行 · 括号内为大限">
      <view class="gong-list">
        <view
          wx:for="{{vm.gongs}}"
          wx:key="key"
          class="gong-card {{item.isMing ? 'gong-card--ming' : ''}}"
        >
          <view class="gong-card__head">
            <text class="gong-card__name">{{item.name}}</text>
            <text class="gong-card__gz">{{item.gan}}{{item.zhi}}</text>
          </view>

          <view class="gong-card__stars">
            <text wx:for="{{item.zhuXing}}" wx:for-item="star" wx:key="star" class="star star--main">
              {{star.label}}
            </text>
            <text wx:if="{{!item.hasZhuXing}}" class="star star--empty">无主星</text>
          </view>

          <view wx:if="{{item.auxStars.length}}" class="gong-card__stars">
            <text wx:for="{{item.auxStars}}" wx:for-item="star" wx:key="*this" class="star">{{star}}</text>
          </view>

          <view wx:if="{{item.minorStars.length}}" class="gong-card__stars">
            <text wx:for="{{item.minorStars}}" wx:for-item="star" wx:key="*this" class="star star--faint">{{star}}</text>
          </view>

          <view class="gong-card__foot">
            <text class="gong-card__meta">{{item.siHuaText ? item.siHuaText + ' 化' : ''}}</text>
            <text class="gong-card__meta">{{item.daXianText}}</text>
          </view>
        </view>
      </view>
    </paper-card>

    <paper-card title="命盘信息">
      <view wx:for="{{vm.metaRows}}" wx:key="label" class="kv kv--wrap">
        <text class="kv__k">{{item.label}}</text>
        <text class="kv__v">{{item.value}}</text>
      </view>
    </paper-card>

    <template is="ai-panel" data="{{ai: ai}}" />

    <view class="action-bar">
      <view class="ghost-btn" bindtap="onReset">重新起盘</view>
      <view class="ghost-btn" bindtap="onCopyReport">复制报告</view>
    </view>
  </block>

  <text class="footnote">紫微斗数以星曜宫位为断，结果仅供研究参考。</text>
</view>
