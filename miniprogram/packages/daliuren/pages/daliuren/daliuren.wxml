<import src="../../../../templates/birth-form.wxml" />
<import src="../../../../templates/ai-panel.wxml" />

<view class="page-shell">
  <view style="height: {{statusBarHeight}}px"></view>

  <view class="nav-bar">
    <view class="nav-back" bindtap="onBack">‹</view>
    <text class="nav-title">大六壬</text>
  </view>

  <!-- ==================== 表单 ==================== -->
  <block wx:if="{{mode === 'form'}}">
    <view class="hero hero--compact">
      <text class="hero__kicker">DALIUREN · SIX REN</text>
      <text class="hero__title">起课</text>
      <text class="hero__desc">天地盘、四课三传与十二天将一次排出，附月将与旺衰。</text>
    </view>

    <template
      is="birth-form"
      data="{{settings: settings, solarDate: solarDate, timeValue: timeValue, showOccupy: showOccupy, occupyLabel: occupyLabel, error: error}}"
    />

    <paper-card title="贵人取法" hint="昼夜贵人">
      <view class="choice-row">
        <view
          wx:for="{{guiRenTypes}}"
          wx:key="value"
          class="choice {{settings.guiRenType === item.value ? 'choice--active' : ''}}"
          data-field="guiRenType"
          data-value="{{item.value}}"
          bindtap="onSelectOption"
        >{{item.label}}</view>
      </view>
      <text class="field__hint">自动模式按占时昼夜切换；也可固定取昼贵或夜贵。</text>
    </paper-card>

    <button class="primary-btn" loading="{{loading}}" bindtap="onSubmit">{{loading ? '正在排盘' : '开始排盘'}}</button>
  </block>

  <!-- ==================== 结果 ==================== -->
  <block wx:else>
    <view class="res-hero">
      <view class="res-hero__tags">
        <text class="tag tag--dark">大六壬</text>
        <text class="tag tag--dark">月将 {{vm.yueJiang}}</text>
      </view>
      <text class="res-hero__kicker">课体</text>
      <text class="res-hero__name">{{vm.title}}</text>
      <text class="res-hero__sub">{{vm.sub}}</text>

      <view class="chuan-grid">
        <view wx:for="{{vm.sanChuan}}" wx:key="key" class="chuan">
          <text class="chuan__label">{{item.label}}</text>
          <text class="chuan__zhi">{{item.zhi}}</text>
          <text class="chuan__meta">{{item.shenJiang}} · {{item.liuQin}}</text>
          <text class="chuan__meta">遁干 {{item.dunGan}}</text>
        </view>
      </view>
    </view>

    <paper-card title="四课" hint="自左至右：一课 · 二课 · 三课 · 四课">
      <view class="ke-grid">
        <view wx:for="{{vm.siKe}}" wx:key="key" class="ke">
          <text class="ke__label">{{item.label}}</text>
          <text class="ke__shang">{{item.shangJiang}} {{item.shang}}</text>
          <text class="ke__dun">遁 {{item.shangDun}}</text>
          <view class="ke__line"></view>
          <text class="ke__xia">{{item.xiaJiang}} {{item.xia}}</text>
          <text class="ke__dun">遁 {{item.xiaDun}}</text>
        </view>
      </view>
      <text wx:if="{{vm.quFa}}" class="field__hint">三传取法：{{vm.quFa}}</text>
    </paper-card>

    <paper-card title="天地盘" hint="十二宫 · 天盘 / 天将 / 遁干">
      <view class="table">
        <view class="trow trow--head">
          <text class="tcell tcell--label tcell--head">地盘</text>
          <text class="tcell tcell--head">天盘</text>
          <text class="tcell tcell--head">天将</text>
          <text class="tcell tcell--head">遁干</text>
        </view>
        <view wx:for="{{vm.palaceRows}}" wx:key="key" class="trow">
          <text class="tcell tcell--label">{{item.diZhi}}</text>
          <text class="tcell">{{item.tianPan}}</text>
          <text class="tcell">{{item.shenJiang}}</text>
          <text class="tcell tcell--muted">{{item.dunGan}}</text>
        </view>
      </view>
    </paper-card>

    <paper-card title="课式信息">
      <view wx:for="{{vm.metaRows}}" wx:key="label" class="kv kv--wrap">
        <text class="kv__k">{{item.label}}</text>
        <text class="kv__v">{{item.value}}</text>
      </view>
    </paper-card>

    <template is="ai-panel" data="{{ai: ai}}" />

    <view class="action-bar">
      <view class="ghost-btn" bindtap="onReset">重新起课</view>
      <view class="ghost-btn" bindtap="onCopyReport">复制报告</view>
    </view>
  </block>

  <text class="footnote">大六壬以课传为断，结果仅供研究参考。</text>
</view>
